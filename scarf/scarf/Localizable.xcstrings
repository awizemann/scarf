          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo をこのプロファイルに切り替えます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o ScarfGo para este perfil"
          }
        },
