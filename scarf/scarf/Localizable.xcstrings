    "All %lld unmanaged skills will be handed to the curator and become eligible for automatic staling, archiving, and pruning.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld unverwalteten Skills werden an den Kurator übergeben und werden für automatisches Veralten, Archivieren und Bereinigen freigegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %lld habilidades no gestionadas se entregarán al curador y podrán marcarse como obsoletas, archivarse y podarse automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld compétences non gérées seront confiées au curateur et deviendront éligibles à l'obsolescence, l'archivage et l'élagage automatiques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理外のスキル %lld 件がすべてキュレーターに引き渡され、自動的な期限切れ・アーカイブ・整理の対象になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as %lld habilidades não gerenciadas serão entregues ao curador e passarão a ser elegíveis para expiração, arquivamento e remoção automáticos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 %lld 个未托管的技能将移交给策展器,并可能被自动标记为过期、归档或清理。"
          }
        }
      }
    },
