    "Matrix Setup Docs": {},
    "Matrix uses either an access token (preferred) or username/password. Get an access token from Element: Settings → Help & About → Access Token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix nutzt entweder ein Access Token (bevorzugt) oder Benutzername/Passwort. Hol dir ein Access Token in Element: Einstellungen → Hilfe & Info → Access Token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix usa un token de acceso (preferido) o usuario/contraseña. Obtén un token de acceso en Element: Ajustes → Ayuda y acerca de → Access Token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix utilise soit un jeton d'accès (préféré), soit un nom d'utilisateur/mot de passe. Obtenez un jeton d'accès dans Element : Paramètres → Aide & À propos → Access Token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix はアクセストークン(推奨)かユーザー名/パスワードを使用します。Element からアクセストークンを取得してください: 設定 → ヘルプ & 情報 → アクセストークン。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Matrix usa um token de acesso (preferido) ou usuário/senha. Obtenha um token de acesso no Element: Configurações → Ajuda e sobre → Access Token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix 使用访问令牌(推荐)或用户名/密码。从 Element 获取访问令牌:设置 → 帮助与关于 → 访问令牌。"
          }
        }
      }
    },
    "Mattermost Setup Docs": {},
    "Max parallel child agents per delegation batch. Values above 10 multiply API cost linearly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale parallele Sub-Agents pro Delegations-Batch. Werte über 10 vervielfachen die API-Kosten linear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo de agentes hijos en paralelo por lote de delegación. Valores por encima de 10 multiplican el costo de la API linealmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre maximal d'agents enfants parallèles par lot de délégation. Des valeurs supérieures à 10 multiplient le coût API linéairement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "委譲バッチごとの並列子エージェントの最大数。10 を超える値は API コストを線形に増加させます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo de agentes filhos paralelos por lote de delegação. Valores acima de 10 multiplicam o custo de API linearmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每批委派任务的最大并行子 agent 数。超过 10 会使 API 成本线性增加。"
          }
        }
      }
    },
    "Max retries set at create time. Hermes has no update verb — re-create the task to change this.": {
      "comment": "A tooltip for the max retries badge.",
      "isCommentAutoGenerated": true
    },
    "Max time an alias routing key waits for an active turn holding the same session lease. Non-positive values fall back to 1800.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Zeit, die ein Alias-Routing-Schlüssel auf einen aktiven Turn wartet, der dieselbe Sitzungs-Lease hält. Nicht-positive Werte fallen auf 1800 zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo máximo que una clave de enrutamiento de alias espera a un turno activo que posee el mismo arrendamiento de sesión. Los valores no positivos vuelven a 1800."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps maximal qu'une clé de routage alias attend un tour actif détenant le même bail de session. Les valeurs non positives retombent à 1800."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エイリアスルーティングキーが、同じセッションリースを保持しているアクティブなターンを待つ最大時間。0 以下の値は 1800 にフォールバックします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo máximo que uma chave de roteamento de alias espera por um turno ativo segurando o mesmo lease de sessão. Valores não positivos revertem para 1800."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别名路由键等待持有相同会话租约的活跃回合的最长时间。非正值将回退为 1800。"
          }
        }
      }
    },
    "Media in this skill marked with `[[as_document]]` is sent as document attachments instead of inline images on platforms that distinguish (Google Chat, Microsoft Teams).": {
