    "M6 is read-only. Edit config.yaml on the Mac app or via a shell; iOS reflects the current remote state.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M6 ist schreibgeschützt. Bearbeite config.yaml in der Mac-App oder über eine Shell; iOS spiegelt den aktuellen Remote-Zustand wider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
