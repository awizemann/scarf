    "End-to-End Encryption (experimental)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-Verschlüsselung (experimentell)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado de extremo a extremo (experimental)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrement de bout en bout (expérimental)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンド暗号化(実験的)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografia ponta a ponta (experimental)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端加密(实验性)"
          }
        }
      }
    },
    "End-to-end encrypted via iCloud Keychain. With Advanced Data Protection on, the encryption keys never leave your devices. Toggle off to keep the key device-only — each new device must onboard separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-verschlüsselt über iCloud Keychain. Mit aktiviertem Advanced Data Protection verlassen die Schlüssel nie deine Geräte. Deaktiviere die Option, um den Schlüssel nur auf diesem Gerät zu halten — jedes neue Gerät muss dann separat eingerichtet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado de extremo a extremo mediante iCloud Keychain. Con la Protección de Datos Avanzada activada, las claves de cifrado nunca salen de tus dispositivos. Desactívalo para mantener la clave solo en este dispositivo — cada dispositivo nuevo deberá configurarse por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout via le trousseau iCloud. Avec la Protection avancée des données activée, les clés de chiffrement ne quittent jamais vos appareils. Désactivez pour garder la clé sur cet appareil uniquement — chaque nouvel appareil devra être configuré séparément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Keychain 経由でエンドツーエンド暗号化されます。高度なデータ保護が有効な場合、暗号鍵がデバイスの外に出ることはありません。オフにすると鍵はこのデバイスのみに保持され、新しいデバイスごとに個別のオンボーディングが必要になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografado ponta a ponta via iCloud Keychain. Com a Proteção de Dados Avançada ativada, as chaves de criptografia nunca saem dos seus dispositivos. Desative para manter a chave apenas neste dispositivo — cada novo dispositivo precisará ser configurado separadamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud Keychain 端到端加密。启用高级数据保护后,加密密钥永远不会离开你的设备。关闭此项可将密钥仅保留在本设备 — 每台新设备都需要单独配置。"
          }
        }
      }
    },
    "Endpoint": {
