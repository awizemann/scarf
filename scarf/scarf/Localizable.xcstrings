    "Recurring commands you've approved before, mined from session history. Adding one writes it to the command allowlist so it stops prompting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Befehle, die du zuvor genehmigt hast, aus dem Sitzungsverlauf ermittelt. Das Hinzufügen schreibt sie in die Befehls-Allowlist, damit nicht mehr nachgefragt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos recurrentes que has aprobado antes, extraídos del historial de sesiones. Añadir uno lo escribe en la lista blanca de comandos para que deje de preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes récurrentes que vous avez déjà approuvées, extraites de l'historique des sessions. En ajouter une l'écrit dans la liste blanche des commandes pour qu'elle cesse d'être demandée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に承認した繰り返しコマンドを、セッション履歴から抽出したものです。追加するとコマンド許可リストに書き込まれ、以降確認を求められなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos recorrentes que você já aprovou antes, extraídos do histórico de sessões. Adicionar um o grava na lista de comandos permitidos para que pare de solicitar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
