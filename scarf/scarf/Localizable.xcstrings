          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chats que vous démarrez ici sont attribués automatiquement. Les sessions plus anciennes démarrées en CLI se trouvent dans la barre latérale Sessions globale."
          }
