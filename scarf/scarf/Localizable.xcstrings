    "Clears this profile's bot settings — name, blurb, avatar style, pin — so it moves back to Other profiles. The profile itself, its sessions and its memories are untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Bot-Einstellungen dieses Profils — Name, Kurztext, Avatar-Stil, Anheftung — sodass es zurück zu Andere Profile wandert. Das Profil selbst, seine Sitzungen und seine Erinnerungen bleiben unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los ajustes de bot de este perfil — nombre, descripción, estilo de avatar, fijado — para que vuelva a Otros perfiles. El perfil en sí, sus sesiones y sus memorias no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les réglages de bot de ce profil — nom, description, style d'avatar, épinglage — pour qu'il retourne dans Autres profils. Le profil lui-même, ses sessions et ses mémoires ne sont pas touchés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルのボット設定(名前、説明、アバターのスタイル、ピン留め)を消去し、「その他のプロファイル」に戻します。プロファイル自体、そのセッションとメモリはそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa as configurações de bot deste perfil — nome, descrição, estilo do avatar, fixação — para que ele volte a Outros perfis. O perfil em si, suas sessões e suas memórias não são alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此配置的机器人设置 — 名称、简介、头像样式、置顶 — 使其回到其他配置中。配置本身及其会话和记忆不会受到影响。"
          }
        }
      }
    },
    "Click Add to connect to a remote Hermes installation over SSH.": {
