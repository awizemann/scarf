    "Acknowledge — silences this failure signature until the error changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittieren — blendet diese Fehlersignatur aus, bis sich der Fehler ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar — silencia esta firma de fallo hasta que el error cambie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquitter — met en sourdine cette signature d'échec jusqu'à ce que l'erreur change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認 — エラーが変わるまで、この障害シグネチャの通知を抑止します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar — silencia esta assinatura de falha até que o erro mude."
          }
        },
        "zh-Hans": {
