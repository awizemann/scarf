    "Switches ScarfGo to this profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet ScarfGo auf dieses Profil um"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ScarfGo a este perfil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
