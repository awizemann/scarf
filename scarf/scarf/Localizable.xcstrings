    "Restores %@ to its state before the %@ mutation (%@). This adds a new ledger entry — it doesn't erase this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt %@ auf den Zustand vor der %@-Änderung (%@) zurück. Dies fügt einen neuen Ledger-Eintrag hinzu — dieser wird nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Restores %1$@ to its state before the %2$@ mutation (%3$@). This adds a new ledger entry — it doesn't erase this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura %1$@ a su estado anterior a la mutación %2$@ (%3$@). Esto añade una nueva entrada al registro — no borra esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure %1$@ à son état avant la modification %2$@ (%3$@). Cela ajoute une nouvelle entrée au registre — cela n'efface pas celle-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を %2$@ の変更（%3$@）前の状態に復元します。これは台帳に新しいエントリを追加するものであり、このエントリを消去するものではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura %1$@ ao seu estado antes da mutação %2$@ (%3$@). Isso adiciona uma nova entrada ao registro — não apaga esta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %1$@ 恢复到 %2$@ 变更(%3$@)之前的状态。这会添加一条新的台账记录 — 不会抹去此条记录。"
          }
        }
      }
    },
