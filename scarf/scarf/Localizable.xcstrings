    "Backs up the Hermes home (`~/.hermes/`) and every registered project so this server can be reconstructed from scratch.": {
      "comment": "A description of the scope of a full backup.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert das Hermes-Home (`~/.hermes/`) und jedes registrierte Projekt, damit dieser Server von Grund auf wiederhergestellt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace una copia de seguridad del home de Hermes (`~/.hermes/`) y de cada proyecto registrado, para que este servidor pueda reconstruirse desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde le répertoire Hermes (`~/.hermes/`) et tous les projets enregistrés afin que ce serveur puisse être reconstruit de zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes ホーム(`~/.hermes/`)と登録済みのすべてのプロジェクトをバックアップし、このサーバーをゼロから再構築できるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz backup do home do Hermes (`~/.hermes/`) e de todos os projetos registrados para que este servidor possa ser reconstruído do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份 Hermes 主目录(`~/.hermes/`)和每个已注册的项目,以便可以从零重建此服务器。"
          }
        }
      }
    },
