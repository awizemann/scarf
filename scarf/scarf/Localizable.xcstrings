    "Removes %@'s SSH key and host details from this device. Other servers stay configured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den SSH-Schlüssel und die Host-Daten von %@ von diesem Gerät. Andere Server bleiben konfiguriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la clave SSH y los datos de host de %@ de este dispositivo. Los demás servidores siguen configurados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire la clé SSH et les détails d'hôte de %@ de cet appareil. Les autres serveurs restent configurés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の SSH 鍵とホスト情報をこのデバイスから削除します。他のサーバーの設定はそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a chave SSH e os dados de host de %@ deste dispositivo. Os outros servidores permanecem configurados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备中移除 %@ 的 SSH 密钥和主机信息。其他服务器的配置保持不变。"
          }
        }
      }
    },
    "Removes this OAuth provider from auth.json. You'll need to re-authenticate before Hermes can use it again. The upstream provider account is not revoked.": {
      "comment": "A confirmation dialog message for removing an OAuth provider.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diesen OAuth-Anbieter aus auth.json. Du musst dich erneut authentifizieren, bevor Hermes ihn wieder nutzen kann. Das Konto beim Anbieter selbst wird nicht widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita este proveedor OAuth de auth.json. Tendrás que volver a autenticarte antes de que Hermes pueda usarlo de nuevo. La cuenta del proveedor de origen no se revoca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ce fournisseur OAuth de auth.json. Vous devrez vous réauthentifier avant que Hermes puisse à nouveau l'utiliser. Le compte du fournisseur en amont n'est pas révoqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この OAuth プロバイダーを auth.json から削除します。Hermes が再度使用するには再認証が必要です。プロバイダー側のアカウント自体は取り消されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove este provedor OAuth de auth.json. Você precisará reautenticar antes que o Hermes possa usá-lo novamente. A conta do provedor upstream não é revogada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 auth.json 中移除此 OAuth 提供方。在 Hermes 再次使用它之前,你需要重新认证。上游提供方账户不会被撤销。"
          }
        }
      }
    },
    "Removes this server's SSH key and host info from the device. You'll need to add the public key back to `~/.ssh/authorized_keys` to reconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den SSH-Schlüssel und die Host-Daten dieses Servers vom Gerät. Zum erneuten Verbinden musst du den öffentlichen Schlüssel wieder in `~/.ssh/authorized_keys` eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la clave SSH y la información de host de este servidor del dispositivo. Tendrás que volver a añadir la clave pública a `~/.ssh/authorized_keys` para reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire de l'appareil la clé SSH et les infos d'hôte de ce serveur. Vous devrez rajouter la clé publique à `~/.ssh/authorized_keys` pour vous reconnecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーの SSH 鍵とホスト情報をデバイスから削除します。再接続するには、公開鍵を `~/.ssh/authorized_keys` に再度追加する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a chave SSH e as informações de host deste servidor do dispositivo. Você precisará adicionar a chave pública de volta ao `~/.ssh/authorized_keys` para reconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从设备中移除此服务器的 SSH 密钥和主机信息。要重新连接,你需要将公钥重新添加到 `~/.ssh/authorized_keys`。"
          }
        }
      }
    },
