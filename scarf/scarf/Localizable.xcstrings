    "Used for image generation calls. Leave as Provider default unless your provider documents a specific model ID for image-gen.": {
      "comment": "A description of the image-gen model picker.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für Bilderzeugungsaufrufe genutzt. Als Anbieter-Standard belassen, außer dein Anbieter dokumentiert eine spezifische Modell-ID für Bilderzeugung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para las llamadas de generación de imágenes. Déjalo como Predeterminado del proveedor a menos que tu proveedor documente un ID de modelo específico para generación de imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour les appels de génération d'images. Laissez sur Valeur par défaut du fournisseur sauf si votre fournisseur documente un ID de modèle spécifique pour la génération d'images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像生成呼び出しに使用されます。プロバイダーが画像生成用の特定のモデル ID を文書化していない限り、Provider default のままにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para chamadas de geração de imagem. Deixe como Padrão do provedor, a menos que seu provedor documente um ID de modelo específico para geração de imagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于图像生成调用。除非你的提供方为图像生成记录了特定的模型 ID,否则请保持为提供方默认值。"
          }
        }
      }
    },
    "Used when there's no picture — generated from the name otherwise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn kein Bild vorhanden ist — sonst aus dem Namen generiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando no hay imagen — si no, se genera a partir del nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lorsqu'il n'y a pas d'image — généré à partir du nom sinon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像がない場合に使用されます — 未指定の場合は名前から自動生成されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando não há imagem — caso contrário, é gerado a partir do nome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有图片时使用 — 否则会根据名称生成。"
          }
        }
      }
    },
    "User": {
      "localizations": {
        "de": {
