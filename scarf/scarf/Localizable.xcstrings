          }
        }
      }
    },
    "This server runs %@. Update to v0.12 to unlock the autonomous curator, multimodal image input, GMI Cloud / Azure / LM Studio / MiniMax / Tencent providers, and more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server läuft %@. Aktualisiere auf v0.12, um den autonomen Kurator, multimodale Bildeingabe, die Anbieter GMI Cloud / Azure / LM Studio / MiniMax / Tencent und mehr freizuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ejecuta %@. Actualiza a v0.12 para desbloquear el curador autónomo, la entrada de imágenes multimodal, los proveedores GMI Cloud / Azure / LM Studio / MiniMax / Tencent, y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exécute %@. Passez à la v0.12 pour débloquer le curateur autonome, l'entrée d'images multimodale, les fournisseurs GMI Cloud / Azure / LM Studio / MiniMax / Tencent, et plus encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは %@ を実行しています。v0.12 に更新すると、自律キュレーター、マルチモーダル画像入力、GMI Cloud / Azure / LM Studio / MiniMax / Tencent プロバイダーなどが利用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor executa %@. Atualize para a v0.12 para desbloquear o curador autônomo, entrada de imagem multimodal, os provedores GMI Cloud / Azure / LM Studio / MiniMax / Tencent e mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器运行的是 %@。升级到 v0.12 以解锁自主策展器、多模态图片输入、GMI Cloud / Azure / LM Studio / MiniMax / Tencent 提供方等功能。"
          }
        }
      }
    },
    "This skill is in `skills.disabled` in `~/.hermes/config.yaml`. Hermes won't load it. Re-enable from the Mac app's Skills config UI or with `hermes skills config`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Skill steht in `skills.disabled` in `~/.hermes/config.yaml`. Hermes lädt ihn nicht. Aktiviere ihn wieder über die Skills-Konfiguration der Mac-App oder mit `hermes skills config`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta habilidad está en `skills.disabled` en `~/.hermes/config.yaml`. Hermes no la cargará. Vuelve a activarla desde la interfaz de configuración de Habilidades de la app de Mac o con `hermes skills config`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette compétence figure dans `skills.disabled` dans `~/.hermes/config.yaml`. Hermes ne la chargera pas. Réactivez-la depuis l'interface de configuration des compétences de l'app Mac ou avec `hermes skills config`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキルは `~/.hermes/config.yaml` の `skills.disabled` に含まれています。Hermes はこれを読み込みません。Mac アプリのスキル設定 UI または `hermes skills config` で再度有効にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta habilidade está em `skills.disabled` no `~/.hermes/config.yaml`. O Hermes não a carregará. Reative pela interface de configuração de Habilidades do app para Mac ou com `hermes skills config`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能位于 `~/.hermes/config.yaml` 的 `skills.disabled` 中。Hermes 不会加载它。请在 Mac 应用的技能配置界面中或使用 `hermes skills config` 重新启用。"
          }
        }
      }
    },
    "This template has no configuration fields.": {
      "comment": "A description of a template with no configuration fields.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorlage hat keine Konfigurationsfelder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta plantilla no tiene campos de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n'a aucun champ de configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテンプレートには設定項目がありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não tem campos de configuração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
