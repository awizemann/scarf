    "Already added some? They live under bot_peers: in config.yaml — check with %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon welche hinzugefügt? Sie stehen unter bot_peers: in config.yaml — prüfe mit %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya has añadido alguno? Viven bajo bot_peers: en config.yaml — compruébalo con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en avez déjà ajouté ? Ils se trouvent sous bot_peers: dans config.yaml — vérifiez avec %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに追加済みですか? config.yaml の bot_peers: 配下にあります — %@ で確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já adicionou algum? Eles ficam em bot_peers: no config.yaml — verifique com %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经添加过一些?它们位于 config.yaml 的 bot_peers: 下 — 使用 %@ 查看。"
          }
        }
      }
    },
    "Already have profiles? Open Other profiles below to turn one into a bot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast schon Profile? Öffne unten Andere Profile, um eines zu einem Bot zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya tienes perfiles? Abre Otros perfiles abajo para convertir uno en bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà des profils ? Ouvrez Autres profils ci-dessous pour en transformer un en bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにプロファイルがありますか? 下の「その他のプロファイル」を開いて、いずれかをボットにしてください。"
          }
        },
        "pt-BR": {
