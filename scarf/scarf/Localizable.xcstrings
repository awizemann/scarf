        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf ne change pas automatiquement votre modèle actif. Modifiez-le dans les Réglages si vous le souhaitez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
