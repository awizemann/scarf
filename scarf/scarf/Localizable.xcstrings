    },
    "`auth.json` was excluded — re-authenticate AI providers after restore.": {
      "comment": "A warning that will be shown in a restore sheet if",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`auth.json` wurde ausgeschlossen — authentifiziere KI-Anbieter nach der Wiederherstellung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se excluyó `auth.json` — vuelve a autenticar los proveedores de IA tras la restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`auth.json` a été exclu — réauthentifiez les fournisseurs d'IA après la restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`auth.json` は除外されました — 復元後に AI プロバイダーを再認証してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`auth.json` foi excluído — reautentique os provedores de IA após a restauração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`auth.json` 已被排除 — 恢复后请重新认证 AI 提供方。"
          }
        }
      }
    },
    "`bot-chat[:profile]` injects the output into a local profile's Bot Chat as a message the bot responds to — v0.20.6+ only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` schleust die Ausgabe in den Bot Chat eines lokalen Profils als Nachricht ein, auf die der Bot antwortet — nur ab v0.20.6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` inyecta la salida en el Bot Chat de un perfil local como un mensaje al que el bot responde — solo v0.20.6+."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` injecte la sortie dans le Bot Chat d'un profil local sous forme de message auquel le bot répond — v0.20.6+ uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` は、出力をローカルプロファイルの Bot Chat にボットが応答するメッセージとして挿入します — v0.20.6 以降のみ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` injeta a saída no Bot Chat de um perfil local como uma mensagem à qual o bot responde — apenas v0.20.6+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`bot-chat[:profile]` 会将输出作为一条消息注入本地配置的 Bot Chat,并由机器人回应 — 仅限 v0.20.6 及以上。"
          }
        }
      }
    },
    "`delete` trades WAL's crash-safety guarantees for compatibility with weak-fsync or shared filesystems — use it for macOS virtiofs, NFS, or SMB-backed Hermes homes. Autocheckpoint/size-limit pragmas apply only when set; leave them off for SQLite's own defaults (1000-page autocheckpoint, no size cap).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` tauscht die Absturzsicherheits-Garantien von WAL gegen Kompatibilität mit schwachem fsync oder gemeinsam genutzten Dateisystemen — verwende es für macOS-virtiofs-, NFS- oder SMB-basierte Hermes-Homes. Autocheckpoint-/Größenlimit-Pragmas gelten nur, wenn gesetzt; lasse sie aus für SQLites eigene Standards (1000-Seiten-Autocheckpoint, kein Größenlimit)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` cambia las garantías de seguridad ante fallos de WAL por compatibilidad con sistemas de archivos de fsync débil o compartidos — úsalo para directorios de Hermes respaldados por virtiofs de macOS, NFS o SMB. Los pragmas de autocheckpoint/límite de tamaño solo se aplican si están definidos; déjalos sin definir para los valores predeterminados de SQLite (autocheckpoint de 1000 páginas, sin límite de tamaño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` échange les garanties de sécurité en cas de panne du WAL contre la compatibilité avec les systèmes de fichiers à fsync faible ou partagés — utilisez-le pour les répertoires Hermes sur macOS virtiofs, NFS ou SMB. Les pragmas autocheckpoint/limite de taille ne s'appliquent que s'ils sont définis ; laissez-les inactifs pour les défauts propres de SQLite (autocheckpoint à 1000 pages, aucune limite de taille)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` は WAL のクラッシュセーフティ保証を犠牲にして、弱い fsync や共有ファイルシステムとの互換性を得ます — macOS の virtiofs、NFS、SMB 上の Hermes ホームディレクトリで使用してください。autocheckpoint・サイズ上限のプラグマは設定した場合のみ適用されます。設定しない場合は SQLite 自体のデフォルト（1000 ページごとの autocheckpoint、サイズ上限なし）が使われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` troca as garantias de segurança contra falhas do WAL por compatibilidade com fsync fraco ou sistemas de arquivos compartilhados — use-o para homes do Hermes em virtiofs do macOS, NFS ou SMB. As pragmas de autocheckpoint/limite de tamanho só se aplicam quando definidas; deixe-as desativadas para os padrões próprios do SQLite (autocheckpoint de 1000 páginas, sem limite de tamanho)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`delete` 以牺牲 WAL 的崩溃安全保证为代价,换取对弱 fsync 或共享文件系统的兼容性 — 适用于以 macOS virtiofs、NFS 或 SMB 为后端的 Hermes 主目录。自动检查点/大小限制 pragma 仅在设置时生效;不设置则使用 SQLite 自身的默认值(1000 页自动检查点,无大小上限)。"
          }
        }
      }
    },
    "`model.default` is `%@` but `model.provider` is `%@`. Chats will fail at first prompt until this is reconciled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` ist `%@`, aber `model.provider` ist `%@`. Chats schlagen beim ersten Prompt fehl, bis dies abgeglichen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "`model.default` is `%1$@` but `model.provider` is `%2$@`. Chats will fail at first prompt until this is reconciled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` es `%1$@` pero `model.provider` es `%2$@`. Los chats fallarán en el primer prompt hasta que esto se reconcilie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` vaut `%1$@` mais `model.provider` vaut `%2$@`. Les discussions échoueront dès le premier prompt tant que cela n'est pas réconcilié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` は `%1$@` ですが `model.provider` は `%2$@` です。これが解消されるまで、チャットは最初のプロンプトで失敗します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` é `%1$@`, mas `model.provider` é `%2$@`. Os chats falharão no primeiro prompt até que isso seja reconciliado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`model.default` 为 `%1$@`,但 `model.provider` 为 `%2$@`。在此问题得到协调之前,聊天将在首次提示时失败。"
          }
        }
      }
    },
    "`npx` not found on the Hermes host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`npx` auf dem Hermes-Host nicht gefunden."
          }
        },
        "es": {
