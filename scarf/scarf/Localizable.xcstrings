          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire le serveur de config.yaml et supprime tout jeton OAuth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより config.yaml からサーバーが削除され、OAuth トークンも削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
