    "Leave blank in config to let Hermes pick the default Nous model. Picking one above writes it explicitly.": {
      "comment": "A description of the default model selection.",
      "isCommentAutoGenerated": true
    },
    "Leave blank to infer from the model ID's prefix (\"openai/...\" → openai).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um aus dem Präfix der Modell-ID abzuleiten (\"openai/...\" → openai)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para deducirlo del prefijo del ID del modelo (\"openai/...\" → openai)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour déduire du préfixe de l'ID du modèle (« openai/... » → openai)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル ID のプレフィックスから推定するには空のままにします(\"openai/...\" → openai)。"
          }
        },
        "pt-BR": {
