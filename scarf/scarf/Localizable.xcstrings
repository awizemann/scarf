    "All Scarf windows will close and reopen. Unsaved chat input may be lost.": {
      "comment": "A confirmation dialog warning message.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Scarf-Fenster werden geschlossen und neu geöffnet. Ungespeicherte Chat-Eingaben können verloren gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las ventanas de Scarf se cerrarán y volverán a abrir. El texto de chat sin guardar puede perderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
