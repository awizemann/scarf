    "Closes the live connection. Your key and host details stay on this device; tapping the server from the list reconnects with no re-onboarding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt die Live-Verbindung. Dein Schlüssel und die Host-Daten bleiben auf diesem Gerät; ein Tippen auf den Server in der Liste verbindet erneut, ohne neues Onboarding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la conexión en vivo. Tu clave y los datos del host se quedan en este dispositivo; al tocar el servidor en la lista se reconecta sin volver a configurarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme la connexion active. Votre clé et les détails de l'hôte restent sur cet appareil ; toucher le serveur dans la liste vous reconnecte sans nouvelle configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ接続を閉じます。鍵とホストの情報はこのデバイスに残るため、リストからサーバーをタップすれば再オンボーディングなしで再接続できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a conexão ativa. Sua chave e os dados do host permanecem neste dispositivo; tocar no servidor na lista reconecta sem refazer a configuração inicial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭实时连接。你的密钥和主机信息仍保留在此设备上;从列表中点按该服务器即可重新连接,无需重新配置。"
          }
        }
      }
    },
