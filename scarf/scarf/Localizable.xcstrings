    "This removes the server from config.yaml and deletes any OAuth token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird der Server aus config.yaml entfernt und jedes OAuth-Token gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
