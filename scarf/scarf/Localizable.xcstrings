    "If this is the first connection, ensure your key is loaded with `ssh-add` and that the remote accepts it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies die erste Verbindung ist, stelle sicher, dass dein Schlüssel mit `ssh-add` geladen wurde und der Remote ihn akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es la primera conexión, asegúrate de que tu clave esté cargada con `ssh-add` y de que el remoto la acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il s'agit de la première connexion, assurez-vous que votre clé est chargée avec `ssh-add` et que l'hôte distant l'accepte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回接続の場合は、`ssh-add` でキーがロードされていることと、リモートがそれを受け付けていることを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
