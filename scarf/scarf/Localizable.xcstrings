          }
        }
      }
    },
    "This removes the task from `~/.hermes/kanban.db` for good. This cannot be undone.": {
      "comment": "A message displayed in a confirmation dialog when a user attempts to permanently delete a task in the Kanban board.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt die Aufgabe endgültig aus `~/.hermes/kanban.db`. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la tarea de `~/.hermes/kanban.db` de forma definitiva. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement la tâche de `~/.hermes/kanban.db`. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクを `~/.hermes/kanban.db` から完全に削除します。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a tarefa de `~/.hermes/kanban.db` definitivamente. Isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 `~/.hermes/kanban.db` 中永久移除该任务。此操作无法撤销。"
          }
        }
      }
    },
    "This runs hermes profile delete. It removes the whole profile directory — sessions, memories, state.db and .env — and can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies führt hermes profile delete aus. Es entfernt das gesamte Profilverzeichnis — Sitzungen, Erinnerungen, state.db und .env — und kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ejecuta hermes profile delete. Elimina todo el directorio del perfil — sesiones, memorias, state.db y .env — y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela exécute hermes profile delete. Cela supprime tout le répertoire du profil — sessions, mémoires, state.db et .env — et est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは hermes profile delete を実行します。セッション、メモリ、state.db、.env を含むプロファイルディレクトリ全体を削除し、取り消すことはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso executa hermes profile delete. Remove todo o diretório do perfil — sessões, memórias, state.db e .env — e não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将运行 hermes profile delete。它会删除整个配置目录 — 会话、记忆、state.db 和 .env — 且无法撤销。"
          }
        }
      }
    },
    "This runs hermes profile rename, which moves the profile directory and updates its alias.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies führt hermes profile rename aus, wodurch das Profilverzeichnis verschoben und sein Alias aktualisiert wird."
          }
        },
        "es": {
          "stringUnit": {
