    "Reasons appear as a comment on the task and feed into the worker's context if it's later unblocked.": {
      "comment": "A description of how the reason is used.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gründe erscheinen als Kommentar bei der Aufgabe und fließen in den Kontext des Workers ein, falls sie später entsperrt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los motivos aparecen como comentario en la tarea y se incorporan al contexto del worker si más tarde se desbloquea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raisons apparaissent en commentaire sur la tâche et alimentent le contexte du worker si elle est débloquée plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由はタスクへのコメントとして表示され、後でブロック解除された際にワーカーのコンテキストに反映されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os motivos aparecem como um comentário na tarefa e alimentam o contexto do worker se ela for desbloqueada mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因会作为任务上的评论出现,并在任务之后解除阻塞时纳入工作者的上下文。"
          }
        }
      }
    },
    "Reassign this task. Hermes's dispatcher only runs assigned tasks.": {
      "comment": "A description of the task reassigning feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe neu zuweisen. Hermes' Dispatcher führt nur zugewiesene Aufgaben aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna esta tarea. El dispatcher de Hermes solo ejecuta tareas asignadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réassigner cette tâche. Le répartiteur de Hermes n'exécute que les tâches assignées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
