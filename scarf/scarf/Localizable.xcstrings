    "Specificity %lld — every field you fill in must match for this route to win, and each one raises its rank against the other routes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spezifität %lld — jedes ausgefüllte Feld muss übereinstimmen, damit diese Route gewinnt, und jedes erhöht ihren Rang gegenüber den anderen Routen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Especificidad %lld — cada campo que rellenes debe coincidir para que esta ruta gane, y cada uno aumenta su rango frente a las otras rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spécificité %lld — chaque champ que vous renseignez doit correspondre pour que cette route l'emporte, et chacun augmente son rang face aux autres routes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "具体性 %lld — このルートが優先されるには入力したすべてのフィールドが一致する必要があり、フィールドを追加するごとに他のルートに対する順位が上がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Especificidade %lld — todo campo que você preencher deve corresponder para esta rota vencer, e cada um aumenta sua classificação em relação às outras rotas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特定度 %lld — 你填写的每个字段都必须匹配此路由才能胜出,且每个字段都会提升其相对于其他路由的排名。"
          }
        }
      }
    },
