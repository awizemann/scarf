    "Sorted by 95th-percentile duration. Counts include events; intervals are everything wrapped in `ScarfMon.measure`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach der Dauer im 95. Perzentil. Die Zählungen enthalten Ereignisse; Intervalle sind alles, was von `ScarfMon.measure` umschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenado por duración del percentil 95. Los recuentos incluyen eventos; los intervalos son todo lo envuelto en `ScarfMon.measure`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trié par durée au 95e centile. Les décomptes incluent les événements ; les intervalles sont tout ce qui est encadré par `ScarfMon.measure`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "95 パーセンタイルの所要時間で並べ替えています。カウントにはイベントが含まれます。インターバルは `ScarfMon.measure` でラップされたすべてを指します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenado pela duração no percentil 95. As contagens incluem eventos; os intervalos são tudo o que está envolvido por `ScarfMon.measure`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按第 95 百分位耗时排序。计数包含事件;区间指所有由 `ScarfMon.measure` 包裹的内容。"
          }
        }
      }
    },
