    "Hermes plugins live under `~/.hermes/plugins/<name>/`. Install one with `hermes plugins install <repo>` from the Mac app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes-Plugins liegen unter `~/.hermes/plugins/<name>/`. Installiere eines mit `hermes plugins install <repo>` aus der Mac-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins de Hermes viven en `~/.hermes/plugins/<name>/`. Instala uno con `hermes plugins install <repo>` desde la app de Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins Hermes se trouvent sous `~/.hermes/plugins/<name>/`. Installez-en un avec `hermes plugins install <repo>` depuis l'app Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes プラグインは `~/.hermes/plugins/<name>/` 配下にあります。Mac アプリから `hermes plugins install <repo>` を実行してインストールしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
