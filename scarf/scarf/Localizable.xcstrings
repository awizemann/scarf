    "Re-authenticate AI providers and any MCP servers from Settings if those weren't included in the backup.": {
      "comment": "A message that instructs the user to re-authenticate AI providers and MCP servers if they weren't included in the backup.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiziere KI-Anbieter und MCP-Server über die Einstellungen erneut, falls diese nicht in der Sicherung enthalten waren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a autenticar los proveedores de IA y cualquier servidor MCP desde Configuración si no se incluyeron en la copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réauthentifiez les fournisseurs d'IA et les serveurs MCP depuis les Réglages s'ils n'étaient pas inclus dans la sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに含まれていなかった場合は、設定から AI プロバイダーと MCP サーバーを再認証してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reautentique os provedores de IA e quaisquer servidores MCP em Configurações se eles não estavam incluídos no backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果备份中未包含 AI 提供方和 MCP 服务器,请从设置中重新认证它们。"
          }
        }
      }
    },
    "Re-authenticate refreshes tokens; the trash icon removes the provider from auth.json.": {
      "comment": "A description of how to remove an OAuth provider.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
