          }
        }
      }
    },
    "Runs hermes profile delete — removes the profile directory, including sessions, memories, state.db and .env. Can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt hermes profile delete aus — entfernt das Profilverzeichnis samt Sitzungen, Erinnerungen, state.db und .env. Kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta hermes profile delete — elimina el directorio del perfil, incluidas sesiones, memorias, state.db y .env. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute hermes profile delete — supprime le répertoire du profil, y compris les sessions, les mémoires, state.db et .env. Irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hermes profile delete を実行します — セッション、メモリ、state.db、.env を含むプロファイルディレクトリを削除します。取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa hermes profile delete — remove o diretório do perfil, incluindo sessões, memórias, state.db e .env. Não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 hermes profile delete — 删除配置目录,包括会话、记忆、state.db 和 .env。此操作无法撤销。"
          }
        }
      }
    },
    "SOUL.md": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md"
          }
        }
      }
    },
    "SOUL.md describes the agent's voice, values, and personality at ~/.hermes/SOUL.md. It is injected into every session's context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md beschreibt Stimme, Werte und Persönlichkeit des Agents unter ~/.hermes/SOUL.md. Sie wird in den Kontext jeder Sitzung injiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md describe la voz, valores y personalidad del agente en ~/.hermes/SOUL.md. Se inyecta en el contexto de cada sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md décrit la voix, les valeurs et la personnalité de l'agent dans ~/.hermes/SOUL.md. Il est injecté dans le contexte de chaque session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md は ~/.hermes/SOUL.md でエージェントの話し方、価値観、パーソナリティを記述します。これはすべてのセッションのコンテキストに挿入されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SOUL.md descreve a voz, os valores e a personalidade do agente em ~/.hermes/SOUL.md. Ele é injetado no contexto de cada sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md 位于 ~/.hermes/SOUL.md,描述 agent 的语气、价值观与人格。它会被注入到每个会话的上下文中。"
          }
        }
      }
    },
