    "Folder name needs lowercase letters, digits, or dashes — no leading/trailing or doubled dashes.": {
      "comment": "A warning message that appears when a user enters an invalid folder name.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordnername benötigt Kleinbuchstaben, Ziffern oder Bindestriche — keine führenden/abschließenden oder doppelten Bindestriche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de la carpeta necesita letras minúsculas, dígitos o guiones — sin guiones al inicio, al final o duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du dossier doit contenir des lettres minuscules, des chiffres ou des tirets — pas de tirets en début, en fin ou doublés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ名は小文字・数字・ダッシュのみ使用できます — 先頭・末尾のダッシュや連続するダッシュは不可です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da pasta precisa de letras minúsculas, dígitos ou traços — sem traços no início/fim ou duplicados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹名称需为小写字母、数字或短横线 — 不能以短横线开头/结尾,也不能有连续短横线。"
          }
        }
      }
    },
    "Folders only affect how projects are grouped in Scarf's sidebar. Nothing on disk changes.": {
      "comment": "A description of how folders affect project grouping.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner beeinflussen nur, wie Projekte in Scarfs Seitenleiste gruppiert werden. Auf der Festplatte ändert sich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas solo afectan a cómo se agrupan los proyectos en la barra lateral de Scarf. Nada cambia en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers n'affectent que le regroupement des projets dans la barre latérale de Scarf. Rien ne change sur le disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは Scarf のサイドバーでのプロジェクトのグループ化にのみ影響します。ディスク上では何も変わりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas afetam apenas como os projetos são agrupados na barra lateral do Scarf. Nada muda no disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹只影响项目在 Scarf 侧边栏中的分组方式。磁盘上的内容不会改变。"
          }
        }
      }
    },
    "Force generated titles into this language (e.g. `en`, `ja`) regardless of the chat's own language. Leave blank to match the chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwingt generierte Titel in dieser Sprache (z. B. `en`, `ja`), unabhängig von der Sprache des Chats. Leer lassen, um sich an den Chat anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza los títulos generados a este idioma (p. ej. `en`, `ja`) independientemente del idioma del chat. Déjalo vacío para igualar el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer les titres générés dans cette langue (p. ex. `en`, `ja`) quelle que soit la langue de la discussion. Laissez vide pour correspondre à la discussion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット自体の言語に関わらず、生成されるタイトルをこの言語（例: `en`、`ja`）に強制します。空欄にするとチャットに合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força os títulos gerados para este idioma (ex.: `en`, `ja`), independentemente do idioma do próprio chat. Deixe em branco para acompanhar o chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制生成的标题使用此语言(例如 `en`、`ja`),无论聊天本身使用什么语言。留空则与聊天语言一致。"
          }
        }
      }
    },
