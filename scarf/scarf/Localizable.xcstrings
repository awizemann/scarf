    "Bot identities live in each profile's ui_meta, which older agents don't read. Update Hermes on this host and reload.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot-Identitäten stehen im ui_meta jedes Profils, das ältere Agents nicht lesen. Aktualisiere Hermes auf diesem Host und lade neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las identidades de bot viven en el ui_meta de cada perfil, que los agentes antiguos no leen. Actualiza Hermes en este host y recarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identités de bot se trouvent dans le ui_meta de chaque profil, que les agents plus anciens ne lisent pas. Mettez Hermes à jour sur cet hôte et rechargez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットの識別情報は各プロファイルの ui_meta に保存されますが、古いエージェントはこれを読み取りません。このホストの Hermes を更新して再読み込みしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As identidades de bot ficam no ui_meta de cada perfil, que agentes mais antigos não leem. Atualize o Hermes neste host e recarregue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器人身份保存在每个配置的 ui_meta 中,较旧的 agent 不会读取它。请在此主机上更新 Hermes 并重新加载。"
          }
        }
      }
    },
