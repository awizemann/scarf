    "Recommended: ON. Hermes v0.13+ defaults to redacting secrets unless you opt out.": {
      "comment": "A hint that recommends enabling redaction in Hermes v0.13+",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen: EIN. Hermes v0.13+ schwärzt Secrets standardmäßig, sofern du nicht widersprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado: ACTIVADO. Hermes v0.13+ redacta secretos por defecto a menos que lo desactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé : ACTIVÉ. Hermes v0.13+ masque les secrets par défaut, sauf désactivation explicite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨: オン。Hermes v0.13 以降はオプトアウトしない限り、デフォルトでシークレットを編集(redact)します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado: ATIVADO. A partir da v0.13, o Hermes redige segredos por padrão, a menos que você desative."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐:开启。除非你选择退出,否则 Hermes v0.13+ 默认会隐去密钥。"
          }
        }
      }
    },
