          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfert via %@. Utilisez n'importe quel jeton bearer dans votre client — le proxy joint vos identifiants réels."
          }
        },
        "ja": {
          "stringUnit": {
