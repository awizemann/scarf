    "Hermes v0.13 splits search and extract into separate backends. Update Hermes to access the per-capability picker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes v0.13 trennt Suche und Extraktion in separate Backends. Aktualisiere Hermes, um auf die fähigkeitsbasierte Auswahl zuzugreifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes v0.13 divide búsqueda y extracción en backends separados. Actualiza Hermes para acceder al selector por capacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes v0.13 sépare la recherche et l'extraction en backends distincts. Mettez à jour Hermes pour accéder au sélecteur par capacité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes v0.13 では検索と抽出が別々のバックエンドに分割されました。機能ごとのピッカーを利用するには Hermes を更新してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hermes v0.13 divide busca e extração em backends separados. Atualize o Hermes para acessar o seletor por capacidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes v0.13 将搜索和提取拆分为独立的后端。请更新 Hermes 以使用按能力划分的选择器。"
          }
        }
      }
    },
