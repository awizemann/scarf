    "Comment": {
      "comment": "A button that adds a comment to a task.",
      "isCommentAutoGenerated": true
    },
    "Compact a session's history up front when it resumes after this many seconds idle, before the first reply. 0 = off. Example: 1800 = 30 minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimiert den Verlauf einer Sitzung im Voraus, wenn sie nach dieser Anzahl Leerlaufsekunden fortgesetzt wird, noch vor der ersten Antwort. 0 = aus. Beispiel: 1800 = 30 Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta el historial de una sesión por adelantado al reanudarse tras este número de segundos inactiva, antes de la primera respuesta. 0 = desactivado. Ejemplo: 1800 = 30 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacte l'historique d'une session en amont lorsqu'elle reprend après ce nombre de secondes d'inactivité, avant la première réponse. 0 = désactivé. Exemple : 1800 = 30 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアイドル秒数を超えて再開されたセッションでは、最初の返信の前に履歴を事前に圧縮します。0 = オフ。例: 1800 = 30 分。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta antecipadamente o histórico de uma sessão quando ela é retomada após esse número de segundos ociosa, antes da primeira resposta. 0 = desativado. Exemplo: 1800 = 30 minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当会话在空闲这么多秒后恢复时,在首次回复前预先压缩其历史记录。0 = 关闭。例如:1800 = 30 分钟。"
          }
        }
      }
    },
