    "Markdown, Quarto, and HTML exports write files on the remote host, so only stream-capable formats are offered here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown-, Quarto- und HTML-Exporte schreiben Dateien auf dem Remote-Host, daher werden hier nur streamfähige Formate angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones a Markdown, Quarto y HTML escriben archivos en el host remoto, por lo que aquí solo se ofrecen los formatos compatibles con streaming."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exports Markdown, Quarto et HTML écrivent des fichiers sur l'hôte distant, donc seuls les formats compatibles avec le flux sont proposés ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown、Quarto、HTML エクスポートはリモートホスト上にファイルを書き込むため、ここではストリーミング可能な形式のみが提供されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportações em Markdown, Quarto e HTML gravam arquivos no host remoto, então apenas formatos com suporte a fluxo são oferecidos aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown、Quarto 和 HTML 导出会在远程主机上写入文件,因此这里只提供支持流式传输的格式。"
          }
        }
      }
    },
