    "Every curator/agent/user mutation to a skill (archive, absorb, rollback, purge…) is recorded here as it happens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Kurator-/Agent-/Nutzer-Änderung an einem Skill (Archivieren, Aufgehen-lassen, Rollback, Bereinigen…) wird hier bei ihrem Eintreten festgehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mutación de curador/agente/usuario sobre una habilidad (archivar, absorber, revertir, purgar…) se registra aquí a medida que ocurre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification d'une compétence par le curateur, l'agent ou l'utilisateur (archivage, absorption, restauration, purge…) est enregistrée ici au fur et à mesure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュレーター・エージェント・ユーザーによるスキルへの変更（アーカイブ、吸収、ロールバック、削除…）はすべて発生時にここに記録されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda mutação do curador/agente/usuário em uma habilidade (arquivar, absorver, reverter, eliminar…) é registrada aqui conforme acontece."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "策展器/agent/用户对技能的每次变更(归档、吸收、回滚、清除……)都会在发生时记录于此。"
          }
