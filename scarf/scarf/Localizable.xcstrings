    "Saved as a cron job named \"[bot:%@] %@\". For skills, workdir or run history, use the Cron section instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert als Cron-Job mit dem Namen „[bot:%1$@] %2$@“. Für Skills, Arbeitsverzeichnis oder Ausführungsverlauf nutze stattdessen den Cron-Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como un trabajo cron llamado \"[bot:%1$@] %2$@\". Para habilidades, directorio de trabajo o historial de ejecuciones, usa la sección Cron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré comme tâche cron nommée « [bot:%1$@] %2$@ ». Pour les compétences, le répertoire de travail ou l'historique d'exécution, utilisez plutôt la section Cron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"[bot:%1$@] %2$@\" という名前の cron ジョブとして保存しました。スキル、作業ディレクトリ、実行履歴については Cron セクションを使用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo como uma tarefa cron chamada \"[bot:%1$@] %2$@\". Para habilidades, diretório de trabalho ou histórico de execuções, use a seção Cron."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存为名为 \"[bot:%1$@] %2$@\" 的定时任务。如需设置技能、工作目录或查看运行历史,请改用定时任务部分。"
          }
        }
      }
    },
