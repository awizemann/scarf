    "%@ was retired on May 15. Migrate to its successor to keep this provider working.": {
      "comment": "A paragraph explaining that the currently-selected xAI model was retired on May 15 and that the user can migrate to a newer model to continue using the provider.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde am 15. Mai eingestellt. Migriere zu seinem Nachfolger, damit dieser Anbieter weiter funktioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se retiró el 15 de mayo. Migra a su sucesor para que este proveedor siga funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été retiré le 15 mai. Migrez vers son successeur pour que ce fournisseur continue de fonctionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は 5 月 15 日に廃止されました。このプロバイダーを使い続けるには後継に移行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desativado em 15 de maio. Migre para seu sucessor para manter esse provedor funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已于 5 月 15 日弃用。请迁移到其后继版本以保持此提供方正常工作。"
          }
        }
      }
    },
