    "Your Nous subscription was last refreshed %lld days ago. Enable the toggle above to prevent the refresh token from expiring.": {
      "comment": "A warning that the refresh token is stale.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Nous-Abonnement wurde zuletzt vor %lld Tagen aktualisiert. Aktiviere den obigen Schalter, um zu verhindern, dass das Refresh-Token abläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción de Nous se actualizó por última vez hace %lld días. Activa el interruptor de arriba para evitar que el token de renovación caduque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement Nous a été actualisé pour la dernière fois il y a %lld jours. Activez le bouton ci-dessus pour empêcher l'expiration du jeton d'actualisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous のサブスクリプションは %lld 日前に最後に更新されました。リフレッシュトークンの失効を防ぐには、上のトグルを有効にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura Nous foi atualizada pela última vez há %lld dias. Ative a opção acima para evitar que o token de atualização expire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Nous 订阅上次刷新是在 %lld 天前。启用上方的开关以防止刷新令牌过期。"
          }
        }
      }
    },
    "Your SSH key and host settings for %@ will be removed. Other servers stay configured. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein SSH-Schlüssel und die Host-Einstellungen für %@ werden entfernt. Andere Server bleiben konfiguriert. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tu clave SSH y los ajustes de host de %@. Los demás servidores siguen configurados. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé SSH et les réglages d'hôte pour %@ seront supprimés. Les autres serveurs restent configurés. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の SSH 鍵とホスト設定が削除されます。他のサーバーの設定はそのまま残ります。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave SSH e as configurações de host de %@ serão removidas. Os outros servidores permanecem configurados. Isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 SSH 密钥和主机设置将被移除。其他服务器的配置保持不变。此操作无法撤销。"
