    "Talking to this bot from here lands in a later update. For now, switch to it with hermes profile use and open Chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Bot von hier aus zu sprechen kommt in einem späteren Update. Wechsle vorerst mit hermes profile use zu ihm und öffne Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablar con este bot desde aquí llegará en una actualización posterior. Por ahora, cambia a él con hermes profile use y abre Chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler à ce bot depuis ici arrivera dans une prochaine mise à jour. Pour l'instant, basculez dessus avec hermes profile use et ouvrez Chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここからこのボットと会話する機能は今後のアップデートで対応予定です。今のところは hermes profile use で切り替えてから「チャット」を開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversar com este bot por aqui chega em uma atualização futura. Por enquanto, mude para ele com hermes profile use e abra o Chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这里与此机器人对话的功能将在后续更新中提供。目前请使用 hermes profile use 切换到它,然后打开聊天。"
          }
        }
      }
    },
    "Tap %@ to create one, or manage them from the Mac app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf %@, um einen zu erstellen, oder verwalte sie in der Mac-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca %@ para crear uno, o gestiónalos desde la app de Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez %@ pour en créer un, ou gérez-les depuis l'app Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をタップして作成するか、Mac アプリから管理してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em %@ para criar um, ou gerencie-os pelo app para Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 %@ 创建一个,或在 Mac 应用中管理它们。"
          }
        }
      }
    },
    "Tap Check for Updates to query each installed skill against its source registry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Nach Updates suchen, um jeden installierten Skill gegen seine Quell-Registry abzufragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Buscar actualizaciones para consultar cada habilidad instalada con su registro de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Rechercher les mises à jour pour interroger le registre source de chaque compétence installée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アップデートを確認」をタップすると、インストール済みの各スキルをソースのレジストリに照会します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Verificar atualizações para consultar cada habilidade instalada no seu registro de origem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按检查更新,以针对源注册表查询每个已安装技能。"
          }
        }
      }
    },
    "Tap a server to connect. Swipe for more actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Server, um dich zu verbinden. Wische für weitere Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un servidor para conectar. Desliza para más acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un serveur pour vous connecter. Balayez pour plus d'actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーをタップすると接続します。スワイプすると他の操作が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um servidor para conectar. Deslize para mais ações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按服务器进行连接。滑动可查看更多操作。"
          }
        }
      }
    },
    "Tap to see the full diagnostic message and timestamp.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um die vollständige Diagnosemeldung und den Zeitstempel zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para ver el mensaje de diagnóstico completo y su marca de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour voir le message de diagnostic complet et son horodatage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると診断メッセージ全文とタイムスタンプが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ver a mensagem de diagnóstico completa e o horário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
