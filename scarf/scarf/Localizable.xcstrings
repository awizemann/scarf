    "Also works: %@": {},
    "Always saved to config — without it, chats silently route to OpenRouter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird immer in der Konfiguration gespeichert — ohne diese werden Chats stillschweigend an OpenRouter geleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre se guarda en la configuración — sin ella, los chats se enrutan silenciosamente a OpenRouter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours enregistré dans la configuration — sans cela, les discussions sont acheminées silencieusement vers OpenRouter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に設定に保存されます — これがないと、チャットは黙って OpenRouter にルーティングされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre salvo na configuração — sem ele, os chats são roteados silenciosamente para o OpenRouter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终保存到配置——否则聊天会静默路由到 OpenRouter。"
          }
        }
      }
    },
    "Anonymous usage statistics only — never message content, hostnames, or file paths. Sent to the app developer to improve Scarf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur anonyme Nutzungsstatistiken — nie Nachrichteninhalte, Hostnamen oder Dateipfade. Werden an den App-Entwickler gesendet, um Scarf zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo estadísticas de uso anónimas — nunca contenido de mensajes, nombres de host o rutas de archivo. Se envían al desarrollador de la app para mejorar Scarf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques d'utilisation anonymes uniquement — jamais le contenu des messages, les noms d'hôte ou les chemins de fichiers. Envoyées au développeur de l'application pour améliorer Scarf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の使用統計のみ — メッセージ内容、ホスト名、ファイルパスは含まれません。Scarf の改善のためアプリ開発者に送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas estatísticas de uso anônimas — nunca conteúdo de mensagens, nomes de host ou caminhos de arquivo. Enviadas ao desenvolvedor do app para melhorar o Scarf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅匿名使用统计——绝不包含消息内容、主机名或文件路径。发送给应用开发者以改进 Scarf。"
          }
        }
      }
    },
