    "Scarf authenticates to your Hermes host with an SSH key. You can generate a new one on this device, or import one you already use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf authentifiziert sich bei deinem Hermes-Host mit einem SSH-Schlüssel. Du kannst auf diesem Gerät einen neuen erzeugen oder einen bereits genutzten importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf se autentica en tu host de Hermes con una clave SSH. Puedes generar una nueva en este dispositivo o importar una que ya uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf s'authentifie auprès de votre hôte Hermes avec une clé SSH. Vous pouvez en générer une nouvelle sur cet appareil, ou importer une clé que vous utilisez déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf は SSH 鍵で Hermes ホストに認証します。このデバイスで新しい鍵を生成することも、すでに使用している鍵をインポートすることもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Scarf se autentica no seu host do Hermes com uma chave SSH. Você pode gerar uma nova neste dispositivo ou importar uma que já usa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarf 使用 SSH 密钥向你的 Hermes 主机进行认证。你可以在此设备上生成一个新密钥,或导入一个你已在使用的密钥。"
          }
        }
      }
    },
    "Scarf doesn't auto-switch your active model. Change it in Settings if you'd like.": {
      "comment": "A description of the warning about not switching models.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
