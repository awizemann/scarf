    "Switch to **Full** above to see live stats and copy a JSON dump. Off and Signpost-only modes don't keep an in-memory ring buffer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle oben zu **Vollständig**, um Live-Statistiken zu sehen und einen JSON-Dump zu kopieren. Die Modi Aus und Nur Signposts halten keinen Ringpuffer im Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a **Completo** arriba para ver estadísticas en vivo y copiar un volcado JSON. Los modos Desactivado y Solo señal no mantienen un búfer circular en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en mode **Complet** ci-dessus pour voir les statistiques en direct et copier un export JSON. Les modes Désactivé et Signpost uniquement ne conservent pas de tampon circulaire en mémoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ統計を表示して JSON ダンプをコピーするには、上で **フル** に切り替えてください。オフと「Signpost のみ」のモードではインメモリのリングバッファを保持しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude para **Completo** acima para ver estatísticas em tempo real e copiar um dump JSON. Os modos Desativado e Somente signpost não mantêm um buffer circular em memória."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到上方的 **Full** 模式即可查看实时统计并复制 JSON 转储。关闭和仅 Signpost 模式不会保留内存环形缓冲区。"
          }
        }
      }
    },
    "Switch to This Profile": {
      "extractionState": "stale",
      "localizations": {
