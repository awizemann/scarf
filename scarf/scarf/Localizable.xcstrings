    "Override default": {},
    "Override the remote command Scarf uses to invoke Hermes. Useful when `hermes` is a shell function (e.g. `docker compose exec hermes hermes`), an alias, or installed at a non-standard path. Anything `/bin/sh -c \"<value> …\"` can run is accepted — absolute paths, bare command names, or short shell fragments. Leave blank to let Test Connection auto-detect.": {},
    "Overrides the global Reasoning Effort when the active model matches the pattern (exact or common spelling variants — dots/dashes, with/without provider prefix). First match wins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt den globalen Reasoning Effort, wenn das aktive Modell zum Muster passt (exakt oder gängige Schreibvarianten — Punkte/Bindestriche, mit/ohne Anbieter-Präfix). Der erste Treffer gewinnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el esfuerzo de razonamiento global cuando el modelo activo coincide con el patrón (exacto o variantes comunes de grafía — puntos/guiones, con/sin prefijo de proveedor). Gana la primera coincidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace l'effort de raisonnement global lorsque le modèle actif correspond au motif (exact ou variantes d'orthographe courantes — points/tirets, avec ou sans préfixe de fournisseur). La première correspondance l'emporte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなモデルがこのパターンに一致する場合（完全一致、またはドット・ダッシュの有無やプロバイダープレフィックスの有無など一般的な表記ゆれ）、グローバルの推論エフォートを上書きします。最初に一致したものが優先されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o Esforço de Raciocínio global quando o modelo ativo corresponde ao padrão (variantes exatas ou comuns de grafia — pontos/traços, com/sem prefixo de provedor). A primeira correspondência prevalece."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当活跃模型匹配该模式时(精确匹配或常见拼写变体——点/短横线、带/不带提供方前缀),将覆盖全局推理强度。以首个匹配为准。"
          }
        }
      }
    },
