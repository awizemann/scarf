    "Skills in this repo are ignored until you trust it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills in diesem Repo werden ignoriert, bis du ihm vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las habilidades de este repositorio se ignoran hasta que confíes en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences de ce dépôt sont ignorées tant que vous ne lui faites pas confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼するまで、このリポジトリ内のスキルは無視されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As habilidades neste repositório são ignoradas até que você confie nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在信任此仓库之前,其中的技能将被忽略。"
          }
        }
      }
    },
    "Skills in this repo load for sessions started here, ahead of same-named profile skills.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills in diesem Repo werden für hier gestartete Sitzungen geladen, vor gleichnamigen Profil-Skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las habilidades de este repositorio se cargan para las sesiones iniciadas aquí, antes que las habilidades del perfil con el mismo nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences de ce dépôt se chargent pour les sessions démarrées ici, avant les compétences de profil de même nom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリのスキルは、ここで開始したセッションに対して、同名のプロファイルスキルより優先して読み込まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As habilidades neste repositório carregam para sessões iniciadas aqui, antes das habilidades do perfil com o mesmo nome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库中的技能会在此处启动的会话中加载,优先于同名的配置技能。"
          }
        }
      }
    },
    "Skills with no provenance marker are never auto-staled or archived. Adopting hands them to the curator.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills ohne Herkunftsmarkierung werden nie automatisch als veraltet markiert oder archiviert. Übernehmen übergibt sie an den Kurator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las habilidades sin marcador de procedencia nunca se marcan como obsoletas ni se archivan automáticamente. Adoptarlas las entrega al curador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences sans marqueur de provenance ne sont jamais automatiquement rendues obsolètes ou archivées. Les adopter les confie au curateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出所マーカーのないスキルは自動的に期限切れやアーカイブになることはありません。採用するとキュレーターに引き渡されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilidades sem marcador de proveniência nunca são marcadas como obsoletas ou arquivadas automaticamente. Adotar as entrega ao curador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有来源标记的技能永远不会被自动标记为过期或归档。接管会将它们移交给策展器。"
          }
        }
      }
    },
