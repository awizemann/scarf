    "ScarfGo": {},
    "ScarfGo will reload to show this profile. The server's own active profile — what the Mac app and terminal use — won't change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo lädt neu, um dieses Profil anzuzeigen. Das aktive Profil des Servers selbst — das, was Mac-App und Terminal nutzen — ändert sich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo se recargará para mostrar este perfil. El perfil activo propio del servidor — el que usan la app de Mac y el terminal — no cambiará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo se rechargera pour afficher ce profil. Le profil actif du serveur — celui qu'utilisent l'app Mac et le terminal — ne changera pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo が再読み込みされ、このプロファイルが表示されます。サーバー自身のアクティブなプロファイル(Mac アプリやターミナルが使用するもの)は変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ScarfGo será recarregado para mostrar este perfil. O perfil ativo do próprio servidor — o que o app para Mac e o terminal usam — não mudará."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScarfGo 将重新加载以显示此配置。服务器自身的活跃配置 — 即 Mac 应用和终端所使用的配置 — 不会改变。"
          }
        }
