    "Recent real user messages guaranteed to survive uncompressed, even when bulky tool output fills the tail budget. Hermes default: 1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle echte Nutzernachrichten, die garantiert unkomprimiert erhalten bleiben, selbst wenn umfangreiche Tool-Ausgaben das Tail-Budget füllen. Hermes-Standard: 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes recientes reales del usuario garantizados para sobrevivir sin comprimir, incluso cuando la salida voluminosa de herramientas llena el presupuesto final. Por defecto de Hermes: 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages utilisateur réels récents garantis de survivre non compressés, même quand une sortie d'outil volumineuse remplit le budget de fin. Par défaut Hermes : 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大量のツール出力が末尾の予算を占めている場合でも、圧縮されずに残ることが保証される直近の実際のユーザーメッセージの数。Hermes のデフォルト: 1。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens reais recentes do usuário garantidas a sobreviver sem compactação, mesmo quando saídas volumosas de ferramentas preenchem o orçamento final. Padrão do Hermes: 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保近期的真实用户消息不被压缩保留,即使大量工具输出占满了尾部预算。Hermes 默认值:1。"
          }
        }
      }
    },
