    "YOLO mode is on — dangerous commands run without approval. Toggle via `/yolo` or change approvals.mode in Settings → Agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YOLO-Modus ist an — gefährliche Befehle laufen ohne Genehmigung. Umschalten via `/yolo` oder approvals.mode in Einstellungen → Agent ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo YOLO está activado — los comandos peligrosos se ejecutan sin aprobación. Actívalo/desactívalo con `/yolo` o cambia approvals.mode en Configuración → Agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode YOLO est activé — les commandes dangereuses s'exécutent sans approbation. Basculez via `/yolo` ou changez approvals.mode dans Réglages → Agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YOLO モードがオンです — 危険なコマンドが承認なしで実行されます。`/yolo` で切り替えるか、設定 → Agent で approvals.mode を変更してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo YOLO está ativado — comandos perigosos são executados sem aprovação. Alterne via `/yolo` ou mude approvals.mode em Configurações → Agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YOLO 模式已开启 — 危险命令无需批准即可运行。可通过 `/yolo` 切换,或在设置 → Agent 中更改 approvals.mode。"
          }
        }
      }
    },
