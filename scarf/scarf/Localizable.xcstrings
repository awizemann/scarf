          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes ホストで `npx` が見つかりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`npx` não encontrado no host do Hermes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
