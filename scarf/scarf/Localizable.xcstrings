    "Create a personal access token under Profile → Security → Personal Access Tokens, or create a bot account. Use the token as the MATTERMOST_TOKEN value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein persönliches Access Token unter Profil → Sicherheit → Personal Access Tokens oder ein Bot-Konto. Verwende das Token als MATTERMOST_TOKEN-Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un token de acceso personal en Perfil → Seguridad → Personal Access Tokens, o crea una cuenta de bot. Usa el token como valor de MATTERMOST_TOKEN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un jeton d'accès personnel sous Profil → Sécurité → Personal Access Tokens, ou créez un compte bot. Utilisez le jeton comme valeur de MATTERMOST_TOKEN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル → セキュリティ → Personal Access Tokens でパーソナルアクセストークンを作成するか、ボットアカウントを作成してください。そのトークンを MATTERMOST_TOKEN の値として使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um token de acesso pessoal em Perfil → Segurança → Personal Access Tokens ou crie uma conta de bot. Use o token como valor de MATTERMOST_TOKEN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 配置 → 安全 → 个人访问令牌 下创建个人访问令牌,或创建机器人账号。将该令牌用作 MATTERMOST_TOKEN 的值。"
          }
        }
      }
    },
    "Create a preset to bind it to a project. Each project can run on a different model without touching config.yaml.": {
      "comment": "A description of how to create a model preset.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Preset, um es an ein Projekt zu binden. Jedes Projekt kann auf einem anderen Modell laufen, ohne config.yaml anzufassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un preajuste para vincularlo a un proyecto. Cada proyecto puede ejecutarse con un modelo distinto sin tocar config.yaml."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un préréglage pour l'associer à un projet. Chaque projet peut fonctionner avec un modèle différent sans toucher à config.yaml."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを作成してプロジェクトに紐付けます。config.yaml に触れずに、プロジェクトごとに異なるモデルで実行できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma predefinição para vinculá-la a um projeto. Cada projeto pode rodar em um modelo diferente sem tocar em config.yaml."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个预设并将其绑定到项目。每个项目都可以运行不同的模型,而无需修改 config.yaml。"
          }
        }
      }
    },
    "Create a profile to isolate config and skills.": {
      "localizations": {
