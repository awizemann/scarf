    "Saving rewrites this profile's profile.yaml. If Hermes Desktop is editing the same bot at the same time, the last save wins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wird die profile.yaml dieses Profils neu geschrieben. Wenn Hermes Desktop gleichzeitig denselben Bot bearbeitet, gewinnt der letzte Speichervorgang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se reescribe el profile.yaml de este perfil. Si Hermes Desktop está editando el mismo bot al mismo tiempo, gana el último guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement réécrit le profile.yaml de ce profil. Si Hermes Desktop modifie le même bot en même temps, le dernier enregistrement l'emporte."
          }
