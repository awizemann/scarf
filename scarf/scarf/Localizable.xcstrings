    "Capability-gated UI is hidden. Check that `hermes` is on PATH and `hermes --version` returns a recognizable line.": {
      "comment": "A message within the Hermes Capabilities Panel that instructs the user to check their system for the `hermes` command and its output.",
      "isCommentAutoGenerated": true
    },
    "Caps simultaneous calls for this task to reduce request-burst 429s during provider incidents. 0 = unlimited (legacy behavior).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt gleichzeitige Aufrufe für diese Aufgabe, um Request-Burst-429-Fehler bei Anbieterstörungen zu reduzieren. 0 = unbegrenzt (bisheriges Verhalten)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita las llamadas simultáneas para esta tarea, reduciendo ráfagas de errores 429 durante incidentes del proveedor. 0 = ilimitado (comportamiento heredado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plafonne les appels simultanés pour cette tâche afin de réduire les erreurs 429 en rafale lors d'incidents fournisseur. 0 = illimité (comportement historique)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクの同時呼び出し数を制限し、プロバイダー障害時のリクエストバーストによる 429 エラーを軽減します。0 = 無制限（従来の動作）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita chamadas simultâneas para essa tarefa a fim de reduzir erros 429 em rajada durante incidentes do provedor. 0 = ilimitado (comportamento legado)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制此任务的并发调用数,以减少提供方故障期间请求突发导致的 429 错误。0 = 无限制(旧行为)。"
          }
        }
      }
    },
    "Category": {
      "comment": "A label for the category of a template.",
      "isCommentAutoGenerated": true
    },
    "Changes won't take effect until Hermes reloads the config.": {
      "localizations": {
