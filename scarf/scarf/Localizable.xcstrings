    "Local view — Hermes manages the actual queue server-side. The next prompt runs automatically when the current turn finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Ansicht — Hermes verwaltet die eigentliche Warteschlange serverseitig. Der nächste Prompt läuft automatisch, sobald der aktuelle Turn endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista local — Hermes gestiona la cola real del lado del servidor. El siguiente prompt se ejecuta automáticamente cuando termina el turno actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue locale — Hermes gère la file d'attente réelle côté serveur. Le prochain prompt s'exécute automatiquement à la fin du tour en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルビュー — 実際のキューはサーバー側で Hermes が管理します。現在のターンが終わると次のプロンプトが自動的に実行されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualização local — o Hermes gerencia a fila real no lado do servidor. O próximo prompt roda automaticamente quando o turno atual terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地视图 — 实际队列由 Hermes 在服务端管理。当前回合结束后,下一条提示会自动运行。"
          }
        }
      }
    },
