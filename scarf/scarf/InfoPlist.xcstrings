    "NSMicrophoneUsageDescription" : {
      "comment" : "Shown by macOS when Scarf first requests microphone access for Hermes voice chat.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf verwendet das Mikrofon für die Sprachfunktionen, die du startest: den Hermes-Sprach-Chat und Live-Voice-Sitzungen, die deine Stimme direkt von diesem Mac an OpenAI übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf uses the microphone for the voice features you start: Hermes voice chat, and Live Voice sessions, which stream your voice directly from this Mac to OpenAI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf usa el micrófono para las funciones de voz que inicies: el chat de voz de Hermes y las sesiones de Live Voice, que transmiten tu voz directamente desde este Mac a OpenAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf utilise le microphone pour les fonctions vocales que vous lancez : le chat vocal de Hermes et les sessions Live Voice, qui transmettent votre voix directement de ce Mac à OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf は、あなたが開始する音声機能（Hermes の音声チャット、およびこの Mac から OpenAI へ音声を直接ストリーミングする Live Voice セッション）のためにマイクを使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Scarf usa o microfone para os recursos de voz que você inicia: o chat de voz do Hermes e as sessões de Live Voice, que transmitem sua voz diretamente deste Mac para a OpenAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf 使用麦克风来支持你启动的语音功能：Hermes 语音聊天，以及会将你的语音直接从这台 Mac 传输到 OpenAI 的 Live Voice 会话。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf wandelt deine Sprache auf diesem Mac in Text um, für Sprachgespräche mit Hermes. Nichts von dem, was du sagst, wird an Apple gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf turns your speech into text on this Mac for voice conversations with Hermes. Nothing you say is sent to Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf convierte tu voz en texto en este Mac para conversaciones de voz con Hermes. Nada de lo que dices se envía a Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf convertit votre voix en texte sur ce Mac pour les conversations vocales avec Hermes. Rien de ce que vous dites n’est envoyé à Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf は Hermes との音声会話のために、この Mac 上で音声をテキストに変換します。話した内容が Apple に送信されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Scarf converte sua fala em texto neste Mac para conversas por voz com o Hermes. Nada do que você diz é enviado à Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarf 会在这台 Mac 上将你的语音转换为文字，用于与 Hermes 的语音对话。你说的内容不会发送给 Apple。"
          }
        }
      }
    },
