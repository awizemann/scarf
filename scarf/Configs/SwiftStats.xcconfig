// SwiftStats.xcconfig — analytics write-key injection for the `scarf` app target.
//
// The swift-stats write key must never be committed. It reaches the app as:
//
//     SwiftStatsLocal.xcconfig  →  SWIFT_STATS_WRITE_KEY (build setting)
//                               →  SwiftStatsWriteKey (Info.plist)
//                               →  read at runtime by Analytics.swift
//
// `SwiftStatsLocal.xcconfig` is an UNCOMMITTED sibling of this file
// (gitignored) that a developer or a CI step creates with a single line:
//
//     SWIFT_STATS_WRITE_KEY = sk_stats_…
//
// There is deliberately NO `SWIFT_STATS_WRITE_KEY =` default here. Any
// definition — even an empty one — outranks an environment variable, so a
// placeholder would silently blank a key a CI job passes in the environment
// (swift-stats setup guide §2). The include is optional (`#include?`), so a
// fresh checkout without that file still builds: the setting is undefined,
// `$(SWIFT_STATS_WRITE_KEY)` expands to nothing, and the app degrades to
// no-op analytics at runtime.
//
// CI: export SWIFT_STATS_WRITE_KEY as an environment variable for xcodebuild.
// Never pass it as a `SWIFT_STATS_WRITE_KEY=…` argument — arguments show in
// `ps` and xcodebuild echoes them into the build log.
//
// Rotation happens in the ScarfMon dashboard; no key ever lands in git.

#include? "SwiftStatsLocal.xcconfig"
